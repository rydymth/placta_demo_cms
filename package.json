{
  "name": "placta-cms",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:api": "npm run dev -w @placta/api",
    "dev:admin": "npm run start -w @placta/admin",
    "dev:website": "npm run start -w @placta/website",
    "build:contracts": "npm run build -w @placta/contracts",
    "build": "npm run build:contracts && npm run build -w @placta/api -w @placta/admin -w @placta/website"
  }
}
